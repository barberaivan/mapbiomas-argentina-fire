# R data and cache
*.RData
*.rds
*.csv
.Rhistory
.Rproj.user/

# Heavy data/model artifacts live outside git in an Insync-synced "-store" folder,
# symlinked back into the repo by setup.sh. Ignore the symlinks by their bare names
# (a trailing-slash pattern won't match a symlink).
collection-00/models_fit/data
collection-00/models_fit/exports
collection-01/data
collection-01/models-store

# Local machine-specific store location (consumed by setup.sh)
.local-paths

# Local-only scratch work, not for version control
collection-00/data_viz_Lican/

# Temporary files
*.tmp
*.bak

# Environment settings for GEE
.env

# Python
__pycache__/
*.pyc
